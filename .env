# Jarvis Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token_here

# Secure Data Directory (outside project workspace to prevent sync/leak issues)
JARVIS_DATA_DIR=C:/Users/shrey/JarvisData/.secrets

# Google Credentials (Gmail & Calendar)
GOOGLE_CREDENTIALS_FILE=C:/Users/shrey/JarvisData/.secrets/credentials.json
GOOGLE_TOKEN_FILE=C:/Users/shrey/JarvisData/.secrets/token.json


# Audio Settings
TTS_RATE=200
TTS_VOLUME=1.0
